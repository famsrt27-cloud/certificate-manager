{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@certificate-platform/auth": ["packages/auth/src/index.ts"],
      "@certificate-platform/certificate-renderer": ["packages/certificate-renderer/src/index.ts"],
      "@certificate-platform/config": ["packages/config/src/index.ts"],
      "@certificate-platform/contracts": ["packages/contracts/src/index.ts"],
      "@certificate-platform/database": ["packages/database/src/index.ts"],
      "@certificate-platform/domain": ["packages/domain/src/index.ts"],
      "@certificate-platform/queue": ["packages/queue/src/index.ts"],
      "@certificate-platform/storage": ["packages/storage/src/index.ts"],
      "@certificate-platform/template-engine": ["packages/template-engine/src/index.ts"]
    }
  }
}
