# Safe local-development placeholders only. Replace them outside source control.
NODE_ENV=development
LOG_LEVEL=info

POSTGRES_DB=certificate_platform
POSTGRES_USER=certificate_app
POSTGRES_PASSWORD=local-postgres-change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://certificate_app:local-postgres-change-me@127.0.0.1:5432/certificate_platform
DATABASE_MAX_CONNECTIONS=10

REDIS_PASSWORD=local-redis-change-me
REDIS_PORT=6379
REDIS_URL=redis://:local-redis-change-me@127.0.0.1:6379/0

# Local-only placeholder. Generate an independent high-entropy value outside source control.
SESSION_SECRET=local-session-secret-change-me-at-least-32-bytes
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=28800
BCRYPT_COST=12
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_ACCOUNT_MAX=5
LOGIN_RATE_LIMIT_NETWORK_MAX=20
PUBLIC_VERIFICATION_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_VERIFICATION_RATE_LIMIT_NETWORK_MAX=30
PUBLIC_DOWNLOAD_TOKEN_TTL_SECONDS=60
PUBLIC_DOWNLOAD_AUTHORIZE_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_DOWNLOAD_AUTHORIZE_RATE_LIMIT_NETWORK_MAX=10
ADMIN_ALLOWED_ORIGINS=http://localhost:3000
ADMIN_MFA_POLICY=DEFERRED_NON_PRODUCTION

MINIO_ROOT_USER=local-minio-admin
MINIO_ROOT_PASSWORD=local-minio-change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=certificate-platform-private
OBJECT_STORAGE_ACCESS_KEY=local-minio-admin
OBJECT_STORAGE_SECRET_KEY=local-minio-change-me
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_CREATE_BUCKET=true
PARTICIPANT_IMPORT_MAX_BYTES=5242880
PARTICIPANT_IMPORT_MAX_ROWS=10000
PARTICIPANT_IMPORT_MAX_UNCOMPRESSED_BYTES=26214400
PARTICIPANT_IMPORT_RETENTION_HOURS=168
PARTICIPANT_IMPORT_CONCURRENCY=2
CERTIFICATE_GENERATION_CONCURRENCY=2
CERTIFICATE_RENDER_MAX_ASSET_BYTES=10485760
CERTIFICATE_PDF_MAX_BYTES=10485760
VERIFICATION_PUBLIC_BASE_URL=http://localhost:3000
# Local-only base64url-encoded 32-byte placeholder. Replace through secret management.
VERIFICATION_ACTIVE_KID=development-key
# Contains the active signing key and explicitly retained previous verification keys, keyed by kid.
VERIFICATION_SIGNING_KEYS_JSON={"development-key":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"}
BULLMQ_PREFIX=certificate-platform

API_HOST=0.0.0.0
API_PORT=3001
WORKER_HOST=0.0.0.0
WORKER_HEALTH_PORT=3002
READINESS_TIMEOUT_MS=2000
NEXT_PUBLIC_API_BASE_PATH=/api
API_INTERNAL_BASE_URL=http://127.0.0.1:3001
