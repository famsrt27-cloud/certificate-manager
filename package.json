{
  "name": "certificate-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": ">=11.5.2 <12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @certificate-platform/web --filter @certificate-platform/api --filter @certificate-platform/worker dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint apps packages tests *.ts *.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:security": "vitest run packages/auth packages/domain tests/security apps/api/src/routes/admin-auth.test.ts",
    "test:integration": "vitest run apps/api/tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "db:migrate": "pnpm --filter @certificate-platform/database migrate",
    "db:migrate:status": "pnpm --filter @certificate-platform/database migrate:status",
    "compose:config": "docker compose config"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
